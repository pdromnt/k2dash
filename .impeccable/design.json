  "narrative": {
    "northStar": "The Graphite Printer Workspace",
    "overview": "A compact operational interface: graphite chrome, near-white sans-serif labels, thin seams, and restrained Creality green. The workspace prioritizes trustworthy printer state and clearly bounded controls over decorative presentation.\n\nKeep the dense desktop-tool character on phones through reflow, not by shrinking every control. Cream surfaces, serif display headlines, lifestyle copy, and decorative printer illustrations are outside this visual world.",
    "keyCharacteristics": [
      "Dense, visibly grouped work areas.",
      "Plain printer terminology and tabular readings.",
      "Green actions and selections; explicit warning and error states."
    ],
    "rules": [
      {
        "name": "The State Before Decoration Rule",
        "body": "Color communicates action, selection, progress, or printer state; pair status color with a readable label.",
        "section": "colors"
      },
      {
        "name": "The Plain Label Rule",
        "body": "Use short, literal operational labels rather than promotional language or invented section slogans.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep plain labels, visible boundaries, and tabular printer readings.",
      "Do use green for actionable or meaningful state, with text that explains it.",
      "Do preserve physical filament-slot labels and swatches across overview and print setup.",
      "Do reflow controls and allow long filenames to wrap on phones."
    ],
    "donts": [
      "Don't reintroduce cream-and-serif styling, decorative printer art, or lifestyle copy.",
      "Don't communicate warning, error, or connection state through color alone.",
      "Don't hide active-job locks or replace missing telemetry with reassuring invented readings.",
      "Don't use a modal shadow as the default treatment for ordinary panels."
    ]
  }
}
